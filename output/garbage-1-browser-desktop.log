await (async (page) => {
 const base=new URL(page.url()).origin; const status=async()=>await(await page.request.get(base+"/api/model")).json();
 const errors=[]; page.on("pageerror",e=>errors.push(String(e))); await page.setViewportSize({width:1440,height:1050});
 const modelBefore=await status(), initial={feedbackHidden:await page.locator("#feedbackPanel").isHidden(),buttons:await page.locator("button:visible").allTextContents()};
 const responseFor=(path)=>page.waitForResponse(r=>r.url().endsWith(path)&&r.request().method()==="POST");
 let wait=responseFor("/api/draw");await page.locator("#drawButton").click();const rule=await(await wait).json();
 await page.waitForFunction(()=>!document.querySelector("#drawButton").disabled);
 const started=Date.now();wait=responseFor("/api/feedback");await page.locator("#likeButton").click();const like=await(await wait).json();const likeElapsedMs=Date.now()-started;
 let after;for(let i=0;i<100;i++){after=await status();if(after.queue.done>=1&&after.step===modelBefore.step+1)break;await page.waitForTimeout(50);}
 if(after.step!==modelBefore.step+1)throw Error("Background did not update");
 wait=responseFor("/api/ai");await page.locator("#aiButton").click();const ai=await(await wait).json();
 await page.waitForFunction(()=>!document.querySelector("#aiButton").disabled);
 wait=responseFor("/api/feedback");await page.locator("#dislikeButton").click();const dislike=await(await wait).json();
 await page.waitForFunction(()=>!document.querySelector("#dislikeButton").disabled);
 let final;for(let i=0;i<100;i++){final=await status();if(final.queue.done>=2)break;await page.waitForTimeout(50);}
 const desktop=await page.evaluate(()=>({width:innerWidth,scrollWidth:document.documentElement.scrollWidth,buttons:[...document.querySelectorAll("button")].map(b=>({id:b.id,width:b.getBoundingClientRect().width,height:b.getBoundingClientRect().height})),text:document.body.innerText}));
 await page.screenshot({path:"output/playwright/garbage-1-desktop.png",fullPage:true});
 if(/训练|已学习|学习步数|学习\s*\+/.test(desktop.text))throw Error("Training text visible");
 return {initial,modelBefore,rule,like,likeElapsedMs,after,ai,dislike,final,desktop,errors};
})(page);
